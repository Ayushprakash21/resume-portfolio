rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'ayush-admin@portfolio.internal' ||
        request.auth.token.email == 'ayushprakash0021@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Profile: Public readable, only admin can write
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects: Public can read published items; admin can read drafts and write
    match /projects/{docId} {
      allow read: if isAdmin() || resource.data.status == 'published' || resource == null;
      allow write: if isAdmin();
    }

    // Experiences: Public can read published items; admin can read drafts and write
    match /experiences/{docId} {
      allow read: if isAdmin() || resource.data.status == 'published' || resource == null;
      allow write: if isAdmin();
    }

    // Certifications: Public can read published items; admin can read drafts and write
    match /certifications/{docId} {
      allow read: if isAdmin() || resource.data.status == 'published' || resource == null;
      allow write: if isAdmin();
    }

    // Skills: Public readable, admin can write
    match /skills/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Education: Public readable, admin can write
    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings (homepage, about, openToWork, sections, appearance)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SiteSettings: legacy & fallback
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resume document
    match /resume/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media assets metadata
    match /mediaAssets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages: anyone can create (submit contact form), only admin can read or manage
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.email is string &&
                       request.resource.data.name is string &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 5 &&
                       request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // Admin collection
    match /admins/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
